# HTTP listener and frontend assets built by `npm run build`.
LISTEN_ADDR=:8080
STATIC_DIR=./dist
APP_BASE_URL=http://127.0.0.1:5173

# Self-managed GitLab OAuth application.
GITLAB_BASE_URL=https://gitlab.example.internal
GITLAB_CLIENT_ID=replace-with-oauth-application-id
GITLAB_CLIENT_SECRET=replace-with-oauth-application-secret
GITLAB_REDIRECT_URL=http://127.0.0.1:5173/api/auth/gitlab/callback

# Generate at least 32 random bytes. Never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# false only for localhost HTTP development. Set true behind HTTPS.
COOKIE_SECURE=false
